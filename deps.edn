{:paths ["src"]

 ;; Clojure 1.11 is the floor, and the tests run on it unless an alias says
 ;; otherwise. whatwg-url gives the components of a URL as RFC 9421 reads
 ;; them, webcrypto-clj has the keys, signatures and hashes, and wary-fetch
 ;; has the hidden texts and the chaining of futures and promises.
 ;;
 ;; TODO: reconsider the dependency on wary-fetch. It keeps wary-fetch from
 ;; ever parsing structured fields through httpsig, since each would then
 ;; depend on the other. Moving sfv into a library of its own would break
 ;; that cycle, and so would copying the few functions that httpsig takes.
 :deps  {org.clojure/clojure        {:mvn/version "1.11.4"}
         dk.simongray/whatwg-url    {:mvn/version "0.1.0"}
         dk.simongray/webcrypto-clj {:mvn/version "0.1.2"}
         dk.simongray/wary-fetch    {:mvn/version "0.14.0"}}

 :aliases
 {;; clojure -X:test  (data.json reads the tests of structured fields,
  ;; test.check makes the random messages of the generative tests, and
  ;; Visma's library of RFC 9421 verifies what this one signs, and the other
  ;; way round)
  :test {:extra-paths ["test"]
         :extra-deps  {org.clojure/data.json             {:mvn/version "2.5.2"}
                       org.clojure/test.check            {:mvn/version "1.1.3"}
                       net.visma.autopay/http-signatures {:mvn/version "1.3.1"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; clojure -M:cljs compile test  (the tests in Node)
  :cljs {:extra-paths   ["test"]
         :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
         :extra-deps    {thheller/shadow-cljs    {:mvn/version "3.5.3"}
                         org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -M:test:nrepl
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          ;; lets nrepl interrupt runaway evaluations
          :jvm-opts   ["-Djdk.attach.allowAttachSelf"]
          :main-opts  ["-m" "nrepl.cmdline"]}

  ;; clojure -T:build jar | install | deploy  (see build.clj)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}}}
